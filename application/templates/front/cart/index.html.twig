{% extends 'front/layout.html.twig' %}

{% block page_title %}{{ 'cart.title'|trans }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">

    <h1 class="mb-8 text-3xl font-display font-bold tracking-tight">{{ 'cart.title'|trans }}</h1>

    {% if cart.items|length == 0 %}
        <p class="text-muted">{{ 'cart.empty'|trans }}</p>
        <a href="{{ path('front_product_index') }}"
           class="mt-4 inline-block text-sm text-accent hover:underline">
            {{ 'cart.continue_shopping'|trans }}
        </a>
    {% else %}
        <div data-controller="cart"
             data-cart-count-value="{{ cart_item_count() }}">
            <ol class="divide-y divide-border">
                {% for item in cart.items %}
                    {% set variant = item.variant %}
                    {% set product = variant ? variant.product : null %}
                    <li class="flex items-start gap-4 py-5" id="cart-item-{{ item.id }}" data-cart-item-id="{{ item.id }}">

                        {# Product image #}
                        <div class="w-16 h-16 shrink-0 overflow-hidden rounded-md bg-border">
                            {% if product and product.image %}
                                <img src="{{ product.image|aropixel_imagine_filter('product_card') }}"
                                     alt="{{ product.name }}"
                                     class="w-full h-full object-cover">
                            {% endif %}
                        </div>

                        {# Item details #}
                        <div class="flex-1 min-w-0">
                            <p class="font-medium truncate">{{ product ? product.name : '—' }}</p>
                            {% if variant and variant.optionValues|length > 0 %}
                                <p class="text-xs text-muted mt-0.5">{{ variant.optionValuesLabel }}</p>
                            {% endif %}
                            <p class="text-sm text-muted mt-1">
                                {{ (item.unitPrice / 100)|number_format(2, ',', '\u{202F}') }} € / {{ 'cart.item.unit'|trans }}
                            </p>
                        </div>

                        {# Quantity + subtotal #}
                        <div class="shrink-0 flex items-center gap-3">
                            <div class="flex items-center gap-1">
                                <label for="qty-{{ item.id }}" class="sr-only">{{ 'cart.item.quantity'|trans }}</label>
                                <input type="number"
                                       id="qty-{{ item.id }}"
                                       value="{{ item.quantity }}"
                                       min="0"
                                       class="w-14 rounded border border-border px-2 py-1 text-sm text-center focus:outline-none focus:ring-2 focus:ring-accent"
                                       data-action="change->cart#update"
                                       data-item-id="{{ item.id }}"
                                       data-update-url="{{ path('front_cart_update', {itemId: item.id}) }}">
                            </div>
                            <span class="w-16 text-right text-sm font-medium" id="subtotal-{{ item.id }}">
                                {{ (item.total / 100)|number_format(2, ',', '\u{202F}') }} €
                            </span>
                            <button type="button"
                                    class="text-muted hover:text-red-500 transition-colors"
                                    aria-label="{{ 'cart.item.remove'|trans }}"
                                    data-action="click->cart#remove"
                                    data-item-id="{{ item.id }}"
                                    data-remove-url="{{ path('front_cart_remove', {itemId: item.id}) }}">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>

                    </li>
                {% endfor %}
            </ol>

            {# Coupon form #}
            <div class="mt-6 border-t border-border pt-6"
                 data-controller="coupon"
                 data-coupon-apply-url-value="{{ path('front_cart_promotion_apply_coupon') }}"
                 data-coupon-remove-url-value="{{ path('front_cart_promotion_remove_coupon') }}">

                <form class="flex items-center gap-2" data-action="submit->coupon#applyCoupon">
                    <input type="text"
                           data-coupon-target="codeInput"
                           placeholder="{{ 'cart.coupon.placeholder'|trans }}"
                           class="flex-1 rounded border border-border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent">
                    <button type="submit"
                            data-coupon-target="applyButton"
                            class="rounded bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/90 transition-colors">
                        {{ 'cart.coupon.apply'|trans }}
                    </button>
                </form>

                <p class="mt-1 text-sm text-red-600 hidden" data-coupon-target="errorZone"></p>

                {% if cart.promotionCoupon %}
                    <div class="mt-2 flex items-center gap-2 text-sm text-green-700" data-coupon-target="activeZone">
                        <span>{{ 'cart.coupon.active'|trans }}</span>
                        <span class="font-mono font-semibold" data-coupon-target="activeCode">{{ cart.promotionCoupon.code }}</span>
                        <button type="button"
                                class="ml-1 text-gray-400 hover:text-red-500"
                                data-action="coupon#removeCoupon">×</button>
                    </div>
                {% else %}
                    <div class="hidden" data-coupon-target="activeZone">
                        <span>{{ 'cart.coupon.active'|trans }}</span>
                        <span class="font-mono font-semibold" data-coupon-target="activeCode"></span>
                        <button type="button"
                                class="ml-1 text-gray-400 hover:text-red-500"
                                data-action="coupon#removeCoupon">×</button>
                    </div>
                {% endif %}

                {# Promotion adjustments #}
                {% set promotionAdjustments = cart.getAdjustments('order_promotion') %}
                {% if promotionAdjustments|length > 0 %}
                    <table class="mt-4 w-full" data-coupon-target="adjustmentsList">
                        {% for adj in promotionAdjustments %}
                            <tr data-promotions-row>
                                <td class="py-1 text-sm text-gray-600">
                                    {{ adj.label }}
                                    {% if cart.promotionCoupon and adj.originCode == cart.promotionCoupon.promotion.code %}
                                        <button type="button"
                                                class="ml-2 text-gray-400 hover:text-red-500"
                                                data-action="coupon#removeCoupon">×</button>
                                    {% endif %}
                                </td>
                                <td class="py-1 text-sm text-right text-green-700">
                                    {{ (adj.amount / 100)|number_format(2, ',', '\u{202F}') }} €
                                </td>
                            </tr>
                        {% endfor %}
                    </table>
                {% else %}
                    <table class="mt-4 w-full hidden" data-coupon-target="adjustmentsList"></table>
                {% endif %}
            </div>

            {# Totals #}
            <div class="mt-4 space-y-2 border-t border-border pt-4">
                <div class="flex items-center justify-between text-sm text-muted">
                    <span>{{ 'cart.subtotal'|trans }}</span>
                    <span>{{ (cart.itemsTotal / 100)|number_format(2, ',', '\u{202F}') }} €</span>
                </div>
                {% set promotionsTotal = cart.getAdjustmentsTotalRecursively('order_promotion') %}
                <div class="flex items-center justify-between text-sm text-green-700 {{ promotionsTotal == 0 ? 'hidden' : '' }}"
                     data-promotions-row>
                    <span>{{ 'cart.discount'|trans }}</span>
                    <span data-coupon-target="promotionsTotal">{{ (promotionsTotal / 100)|number_format(2, ',', '\u{202F}') }} €</span>
                </div>
            </div>

            <div class="mt-4 flex items-center justify-end gap-4 border-t border-border pt-4">
                <span class="text-sm text-muted">{{ 'cart.total'|trans }}</span>
                <span class="text-lg font-bold" id="cart-total" data-coupon-target="cartTotal">
                    {{ (cart.total / 100)|number_format(2, ',', '\u{202F}') }} €
                </span>
            </div>

            <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-between">
                <a href="{{ path('front_product_index') }}"
                   class="text-sm text-accent hover:underline">
                    {{ 'cart.continue_shopping'|trans }}
                </a>
                <a href="{{ path('front_checkout_address', app_locales|length > 1 ? {_locale: app.request.locale} : {}) }}"
                   class="rounded-md bg-accent px-6 py-3 text-sm font-semibold text-white hover:bg-accent/90 transition-colors text-center">
                    {{ 'cart.checkout'|trans }}
                </a>
            </div>
        </div>
    {% endif %}

</div>
{% endblock %}
