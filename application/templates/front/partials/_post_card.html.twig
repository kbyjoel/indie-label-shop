{% set href = path('front_post_show', {slug: post.slug}) %}
<article class="group">
    <a href="{{ href }}" class="block overflow-hidden rounded-lg">
        <img src="{{ post.image|aropixel_imagine_filter('post_card') }}"
             alt="{{ post.image ? post.image.attrAlt : post.title }}"
             class="w-full aspect-video object-cover transition-transform duration-300 group-hover:scale-105"
             loading="lazy">
    </a>
    <div class="mt-3">
        <p class="text-xs text-muted">{{ post.createdAt|date('d/m/Y') }}</p>
        <h3 class="mt-1 font-display font-semibold leading-tight">
            <a href="{{ href }}" class="hover:text-accent transition-colors">{{ post.title }}</a>
        </h3>
        {% if post.excerpt %}
            <p class="mt-2 text-sm text-muted line-clamp-2">{{ post.excerpt }}</p>
        {% endif %}
    </div>
</article>
